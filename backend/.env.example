# ==============================================================================
# Urban Heat Hotspot Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (for local development) or configure via hosting dashboard.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Server Network Binding
# In development: 127.0.0.1 and port 8000
# In production containers / PaaS: HOST is typically 0.0.0.0 and PORT is set by platform ($PORT)
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins
# Comma-separated list of origins permitted to access this API.
# Development: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Production:  https://your-frontend-domain.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
