# ==============================================================================
# Urban Heat Hotspot Frontend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (for local development) or configure via hosting dashboard.
# NEVER commit the actual .env file or real API keys to version control.
#
# IMPORTANT SECURITY NOTICE:
# Variables prefixed with VITE_ are embedded into the client-side JavaScript bundle
# during the production build and are publicly visible in the user's browser.
# ==============================================================================

# Backend API Base URL
# Development: http://127.0.0.1:8000/api/v1
# Production:  https://your-api-domain.example.com/api/v1 (or /api/v1 for reverse proxy)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# CARTO Basemap API Key (Browser-visible client credential)
# Acquire key from https://carto.com/
# Recommended Production Practice: Restrict this key to your production frontend domain
# in the CARTO dashboard to prevent unauthorized third-party usage.
VITE_CARTO_API_KEY=your_carto_api_key_here
