# ==============================================================================
# Production Deployment Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting docker compose:
#   cp .env.production.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your populated .env file or real secrets to Git.
# - The CARTO API key is passed into the Vite build argument and embedded
#   into the client-side JavaScript bundle for browser-based tile rendering.
# ==============================================================================

# Host port mapping for Nginx HTTP traffic (default: 80)
HOST_PORT=80

# CARTO Basemap API Key (Browser-authenticated basemap tile service)
# Acquire key from https://carto.com/
# Production Security Recommendation: In your CARTO developer dashboard,
# restrict this key to your production domain (e.g., https://yourdomain.com).
VITE_CARTO_API_KEY=your_carto_api_key_here

# Backend CORS Allowed Origins (Comma-separated)
# For reverse-proxied production on the same domain, default localhost and your domain:
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80
